# Local dev defaults. Copy to backend/.env before running. Never commit .env.
FRONTEND_URL=http://localhost:5173
DATA_DIR=./data

# Phase 2: Marengo embeddings
TWELVELABS_API_KEY=your_key_here
PRE_WARM_CLIP_PATH=seed/prewarm.mp4

# Phase 3+
# CLUSTER_THRESHOLD=0.55
# ANTHROPIC_API_KEY=

# Phase 8: Observability
# LOG_FORMAT=console        # default: json. set to console for human-readable local dev
# SENTRY_DSN=               # empty = Sentry disabled (OFFLINE_DEMO-safe)
# SENTRY_ENVIRONMENT=       # optional, e.g. "production" / "staging"
# ADMIN_TOKEN already documented above; reused by /metrics endpoint

# Phase 9: Postgres migration
# DATABASE_URL: Neon DIRECT endpoint (NOT -pooler). Required when METADATA_BACKEND=postgres.
#   Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=
# METADATA_BACKEND: 'sqlite' (v1.0 default, no behavior change) or 'postgres' (v1.1 Neon cutover).
METADATA_BACKEND=sqlite
# KEEPALIVE_INTERVAL_S: Neon SELECT 1 ping interval to defeat scale-to-zero (DEMO-03).
KEEPALIVE_INTERVAL_S=240
# OFFLINE_DEMO: hard-override that forces sqlite + bypasses all v1.1 external deps.
OFFLINE_DEMO=false

# Phase 10: Vercel Blob (D-12, D-19, D-23). STORAGE_BACKEND=blob enables
# Vercel Blob storage. OFFLINE_DEMO=true hard-overrides to local (D-18).
STORAGE_BACKEND=local
# BLOB_READ_WRITE_TOKEN: paste from Vercel Dashboard, Storage, Tokens.
# Empty default — required when STORAGE_BACKEND=blob and OFFLINE_DEMO=false.
BLOB_READ_WRITE_TOKEN=

# Phase 11: Moderation gate (Gemini Flash-Lite classifier; classifier-only CSAM per reconciliation 2026-04-29)
# GEMINI_MODERATION_MODEL=gemini-2.5-flash-lite
# MODERATION_MAX_BUDGET_S=20.0
