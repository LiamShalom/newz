# Copy to .env and fill in values before running the backend.

# Required for real Marengo embeddings. Get from https://playground.twelvelabs.io/
TWELVELABS_API_KEY=your_api_key_here

# Set to "true" for offline dev — returns deterministic fake vectors, no API key needed.
USE_MOCK_EMBEDDINGS=false

# Path to a short video clip used as a throwaway Marengo pre-warm call on startup.
# Created by Phase 2 at backend/seed/prewarm.mp4
PRE_WARM_CLIP_PATH=seed/prewarm.mp4

# Data directory for SQLite DB + clips storage. Default: ./data (local dev)
# On Railway: set DATA_DIR=/data (persistent volume mount)
# DATA_DIR=/data
